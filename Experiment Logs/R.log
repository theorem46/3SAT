         3  !x1 v x4 v x6          x1=T, x4=F, x6=F           3
         4  x1 v !x2 v x5          x1=F, x2=T, x5=F           3
         5  x1 v x2 v x6           x1=F, x2=F, x6=F           3
         6  x1 v x3 v x4           x1=F, x3=F, x4=F           3
         7  !x2 v !x3 v !x5        x2=T, x3=T, x5=T           3
         8  !x2 v !x4 v !x6        x2=T, x4=T, x6=T           3
